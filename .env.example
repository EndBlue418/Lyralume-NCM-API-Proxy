# Fork and deploy NeteaseCloudMusicApiEnhanced/api-enhanced first.
# Use the API project's production URL, not this proxy's URL.
NETEASE_API_URL=https://your-ncm-api.vercel.app
NETEASE_API_FALLBACK_URLS=
NETEASE_API_TIMEOUT_MS=8000
NETEASE_UPSTREAM_LOG=0

# Vercel: obtain both values from your own Upstash Redis database.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional persistent LRU for song metadata and lyrics, not audio files.
# Omit for the one-hour / 32-song cache policy.
LYRALUME_CACHE_MAX_SONGS=100

# Optional enrichment; legacy names retained for compatibility.
FOLIA_MULTI_SOURCE=1
FOLIA_SECONDARY_LYRICS=1
FOLIA_COVER_THUMBNAIL=1
FOLIA_KUGOU=0

# Self-hosting only; leave unset on Vercel.
# REDIS_URL=redis://127.0.0.1:6379
# PORT=3000
# HOST=127.0.0.1
